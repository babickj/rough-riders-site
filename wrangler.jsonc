{
  "name": "rough-riders-site",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/cal/*", "/r/*"]
  },
  // Keep variables and secrets set in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  // Cloudflare Workers AI: free daily allowance, used when no ANTHROPIC_API_KEY is set.
  "ai": { "binding": "AI" },
  // Spond schedule sync every 2 hours; nightly write-up refresh at 10:23 (times are UTC).
  "triggers": { "crons": ["17 */2 * * *", "23 10 * * *"] },
  "observability": { "enabled": true }
}
