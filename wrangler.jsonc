{
  "name": "rough-riders-site",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Keep variables and secrets set in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  // Spond schedule sync every 2 hours (times are UTC).
  "triggers": { "crons": ["17 */2 * * *"] },
  "observability": { "enabled": true }
}
